# Exemplo local, sem credenciais reais. Copie para .env e gere sua SECRET_KEY.
PRODUCTION_MODE=0
SECRET_KEY=troque-por-uma-chave-aleatoria-longa
DATABASE_URL=sqlite:///epi.db
DATA_DIR=instance
APP_HOST=127.0.0.1
APP_PORT=8080
APP_THREADS=6
APP_BASE_URL=http://127.0.0.1:8080
ALLOW_NEGATIVE_STOCK=1
RECEIPT_RETENTION_YEARS=5
TIMEZONE=America/Sao_Paulo
SESSION_COOKIE_SECURE=0

# O envio fica desativado no exemplo. Configure contas proprias antes de habilitar.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=1
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_DEFAULT_SENDER=
DEFAULT_ALERT_EMAIL=alertas@example.invalid
MAIL_SUPPRESS_SEND=1
